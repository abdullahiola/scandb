# ---- Local LLM (default, runs in the `ollama` container) ----
# Any model from https://ollama.com/library. Pick by RAM on the box:
#   qwen2.5:3b-instruct   ~2.5 GB RAM   (default, good JSON, fine on 4 GB VPS)
#   gemma3:4b             ~3.5 GB RAM
#   qwen2.5:7b-instruct   ~5.5 GB RAM   (better accuracy, needs 8 GB VPS)
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_TIMEOUT_MS=120000

# ---- Hosted alternative (optional) ----
# If set together with LLM_PROVIDER=gemini, the frontend uses Gemini instead of Ollama.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=gemini
